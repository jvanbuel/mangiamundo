{
	"name": "web",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"api-types": "npx --yes openapi-typescript@7.13.0 ../contract/openapi.json -o src/lib/api-types.ts"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/geojson": "^7946.0.16",
		"@types/node": "^24.19.2",
		"@types/topojson-client": "^3.1.5",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	},
	"dependencies": {
		"@fontsource-variable/nunito": "^5.3.0",
		"@lucide/svelte": "^1.73.0",
		"maplibre-gl": "^6.18.0",
		"topojson-client": "^3.1.0",
		"world-atlas": "^2.0.2"
	}
}
