# Where restaurants and areas come from: osm (default, no key) or demo (offline fake data).
PLACES_PROVIDER=osm

# Comma-separated Overpass servers for the osm provider, tried in order.
# OVERPASS_URLS=https://overpass-api.de/api/interpreter

BIND=0.0.0.0:8080
DATABASE_URL=sqlite://mangiamundo.db
# Days before a cached area is fetched from the provider again.
CACHE_TTL_DAYS=7
# Built web app to serve at /. Skipped when the directory has no index.html.
STATIC_DIR=../web/build

# Web Push reminders. The key is generated and stored in the database when unset.
# VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Seconds between reminder passes; 0 turns reminders off.
PUSH_INTERVAL_SECS=600

# New food alerts in the native apps; each is off while unset. See the README.
# Contents of the APNs .p8 key, its id and the Apple team id.
# APNS_KEY=
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_TOPIC=app.mangiamundo
# Contents of a Firebase service account key (JSON).
# FCM_SERVICE_ACCOUNT=


# OpenStreetMap notes for closed and missing places. Leave unset locally so tests never
# post real notes. With OSM_NOTES_TOKEN (an OAuth 2 token with the write_notes scope for
# the Mangiamundo OSM account) notes come from that account and mappers can reply;
# without it they are anonymous.
# OSM_NOTES_URL=https://api.openstreetmap.org/api/0.6/notes
# OSM_NOTES_TOKEN=
