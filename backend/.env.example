# Where restaurants come from: osm (default, no key), google, or demo (offline fake data).
# Defaults to google when GOOGLE_MAPS_API_KEY is set.
PLACES_PROVIDER=osm
# Needs "Places API (New)" and "Geocoding API" enabled in Google Cloud.
GOOGLE_MAPS_API_KEY=

BIND=0.0.0.0:8080
DATABASE_URL=sqlite://mangiamundo.db
# Days before a cached area is fetched from the provider again.
CACHE_TTL_DAYS=7
# Built web app to serve at /. Skipped when the directory has no index.html.
STATIC_DIR=../web/build
